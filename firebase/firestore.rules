rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInWithPlayGames() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "playgames.google.com";
    }

    function validUsername(data) {
      return data.username is string
        && data.usernameLower is string
        && data.username.size() >= 3
        && data.username.size() <= 16
        && data.username.matches('^[A-Za-z][A-Za-z0-9_]{2,15}$')
        && data.usernameLower == data.username.lower()
        && !data.usernameLower.matches(
          '^(admin|administrator|moderator|official|support|developer|idleai|idle_ai|firebase|google|anonymous).*'
        );
    }

    /*
     * Public-to-authenticated profile data used by the in-game leaderboard.
     * No Google display name, email or other account information is stored.
     */
    match /profiles/{uid} {
      allow read: if signedIn();

      allow create: if signedInWithPlayGames()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'playGamesPlayerId',
          'username',
          'usernameLower',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playGamesPlayerId is string
        && request.resource.data.playGamesPlayerId.size() > 0
        && request.resource.data.createdAt is timestamp
        && validUsername(request.resource.data)
        /*
         * The username reservation must be part of this SAME atomic commit.
         * This prevents a normal client from creating a profile without also
         * owning the corresponding unique username document.
         */
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.uid == request.auth.uid;

      /*
       * v1 usernames are intentionally permanent. A future rename feature can
       * add a controlled update rule/cooldown later.
       */
      allow update, delete: if false;
    }

    /*
     * Case-insensitive unique username reservation.
     * Document id == usernameLower, e.g. "QuantumLenz" -> "quantumlenz".
     */
    match /usernames/{usernameLower} {
      allow read: if signedIn();

      allow create: if signedInWithPlayGames()
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data)
        /*
         * The matching profile must be created in the same commit.
         */
        && getAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.usernameLower == usernameLower
        && getAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.username == request.resource.data.username;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
