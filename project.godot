; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
; [section] ; section goes between []
; param=value ; assign values to parameters

config_version=5

[application]

config/name="IdleAi"
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/image="res://assets/ui/loading_screen.png"
config/icon="uid://44mag1j18nrj"

[admob]

general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/enable_r8_optimization=false
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-3940256099942544~1458002511"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="IdleAi"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
