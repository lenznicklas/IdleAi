; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section between []
;   param=value

config_version=5

[application]

config/name="IdleAi"
run/main_scene="res://loading.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/image="res://assets/ui/loading_screen.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/show_image=true
config/icon="uid://44mag1j18nrj"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="IdleAi"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
